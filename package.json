{
  "name": "hypomnemata",
  "version": "0.1.0",
  "description": "Personal notebook: to-do, ideas, books, journal and review. Offline, plain Markdown files.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "android": "npm run build && cap sync android",
    "dist": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "Leonardo Sponton",
    "email": "230742162+Leonardo-Sponton@users.noreply.github.com"
  },
  "build": {
    "appId": "io.github.leonardo_sponton.hypomnemata",
    "productName": "Hypomnemata",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.png",
      "resources/tray.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "executableName": "hypomnemata",
      "synopsis": "Offline notes, to-do, ideas and books",
      "desktop": {
        "entry": {
          "StartupWMClass": "Hypomnemata"
        }
      },
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Hypomnemata-${version}-${arch}.AppImage"
    },
    "artifactName": "hypomnemata-${version}-${arch}.${ext}"
  },
  "desktopName": "hypomnemata.desktop"
}
