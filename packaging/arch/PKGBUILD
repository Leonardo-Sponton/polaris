# Arch package made from the Linux build of this repo (`npm run dist` → release/*.tar.gz).
# Build and install:  cd packaging/arch && makepkg -si
pkgname=polaris
pkgver=0.1.0
pkgrel=1
pkgdesc="Offline notes, to-do, ideas and books in plain Markdown files"
arch=('x86_64')
url="https://github.com/Leonardo-Sponton/polaris"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libnotify')
optdepends=('libappindicator-gtk3: tray icon on some desktops')
options=('!strip' '!debug')
# The tarball is read straight from release/ (not via source=): makepkg keeps a cached
# copy of file:// sources and would silently package an old build.
source=("polaris.desktop")
sha256sums=('SKIP')

prepare() {
  tar -xzf "${startdir}/../../release/polaris-${pkgver}-x64.tar.gz" -C "$srcdir"
}

package() {
  install -d "$pkgdir/opt/polaris"
  cp -a "polaris-${pkgver}-x64/." "$pkgdir/opt/polaris/"
  install -d "$pkgdir/usr/bin"
  chmod 4755 "$pkgdir/opt/polaris/chrome-sandbox"
  ln -s /opt/polaris/polaris "$pkgdir/usr/bin/polaris"
  install -Dm644 polaris.desktop "$pkgdir/usr/share/applications/polaris.desktop"
  install -Dm644 "${startdir}/../../resources/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/polaris.png"
  install -Dm644 "$pkgdir/opt/polaris/LICENSE.electron.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
}
